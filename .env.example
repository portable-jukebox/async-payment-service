APP_NAME="Payment Service Async"

POSTGRES_DB=payments
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

DATABASE_URL=postgresql+asyncpg://admin:admin@127.0.0.1:5433/payments
# pytest overrides connection settings with the isolated compose.test.yaml endpoints.

API_KEY=dev-api-key

# Required by the worker. Generate a unique value, e.g. python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SIGNING_SECRET=

OUTBOX_CLEANUP_ENABLED=false
OUTBOX_RETENTION_DAYS=7
OUTBOX_CLEANUP_BATCH_SIZE=500
OUTBOX_CLEANUP_INTERVAL_SECONDS=3600

RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin
RABBITMQ_URL=amqp://admin:admin@127.0.0.1:5672/
# Process metrics endpoints; publish only on trusted networks.
METRICS_ENABLED=true
WORKER_METRICS_PORT=9001
PUBLISHER_METRICS_PORT=9002
